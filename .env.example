# Copy this file to .env and fill in the values you need.
# Never commit your real .env — it is already in .gitignore.

# --- Google Gemini (cloud LLM, free tier) ------------------------------------
# Required only for --llm gemini. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin a specific Gemini model (otherwise the live model list is used)
# GEMINI_MODEL=gemini-flash-latest

# --- Ollama (local LLM, no key needed) ---------------------------------------
# Server URL if Ollama runs on another machine/port
# OLLAMA_HOST=http://localhost:11434
# Preferred local model (auto-fallback: llama3 -> llama3.1 -> gemma4)
# OLLAMA_MODEL=llama3
# Context window / max output tokens for the local model
# OLLAMA_NUM_CTX=6144
# OLLAMA_NUM_PREDICT=4096
